SERVICE_NAME=root_agent
LOG_LEVEL=INFO

# Активный профиль LLM из src/core/llm_config.json
# Возможные значения: local_qwen_agent, api_qwen_agent, api_deepseek_agent, api_glm_flash_agent
ACTIVE_LLM_PROFILE=api_deepseek_agent

# API-ключ для облачных профилей (dslab). НЕ коммитить реальный ключ.
DSLAB_API_KEY=

# Адрес MCP-сервера верификации.
# Локальный запуск (вне docker):        http://localhost:3010/mcp
# Внутри docker-compose (имя сервиса):  http://verification_mcp_server:3010/mcp
MCP_VERIFICATION_URL=http://localhost:3010/mcp
